<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/etFolderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Название папки"
            android:inputType="text" />

        <CheckBox
            android:id="@+id/cbShowLabels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Показывать названия меток"
            android:layout_marginTop="8dp" />

        <CheckBox
            android:id="@+id/cbShowIcons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Показывать иконки меток"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Тип иконки по умолчанию"
            android:layout_marginTop="16dp" />

        <Spinner
            android:id="@+id/spinnerFolderIcons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
